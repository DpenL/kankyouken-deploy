Verifying it works
------------------
  # should be rejected, and should appear in audit_log
  curl -sS -X POST "$BASE/functions/v1/event-collector" \
    -H "Content-Type: application/json" -H "apikey: $ANON_KEY" \
    -d '{"participant_id":"'$PID'","study_id":"'$SID'","event_type":"consent_recorded"}'

  docker exec -i supabase-db psql -U postgres -d "$POSTGRES_DB" \
    -c "select action, target, timestamp from audit_log order by timestamp desc limit 5;"

  # and a good one should now carry a schema_id
  docker exec -i supabase-db psql -U postgres -d "$POSTGRES_DB" \
    -c "select event_type, schema_id from events order by created_at desc limit 5;"