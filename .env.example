########################################################################
# KanKyouKen pilot — environment template.
#
# Copy to `.env` ON THE VM ONLY, fill in real values, chmod 600.
# NEVER commit the filled-in .env (see .gitignore).
#
# Generate the secrets below with:
#   POSTGRES_PASSWORD  : openssl rand -hex 24
#   JWT_SECRET         : openssl rand -hex 32          (>= 32 chars)
#   SECRET_KEY_BASE    : openssl rand -base64 48       (>= 64 chars)
#   DASHBOARD_PASSWORD : openssl rand -hex 16
#   ANON_KEY / SERVICE_ROLE_KEY : JWTs signed with JWT_SECRET, roles
#     "anon" / "service_role". Use supabase/docker utils/generate-keys.sh
#     (see UPSTREAM.md) or jwt.io. Do NOT reuse the demo keys.
########################################################################

# --- Secrets (CHANGE ALL) ---
POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
# NOT a random string. ANON_KEY and SERVICE_ROLE_KEY are JWTs SIGNED WITH JWT_SECRET,
# carrying {"iss":"supabase","role":"anon"|"service_role","iat":...,"exp":...}.
# Generating them with openssl rand produces a stack that starts cleanly and then
# rejects every request. Mint them from JWT_SECRET (supabase.com/docs/guides/self-hosting#api-keys).
ANON_KEY=CHANGE_ME_JWT_ANON
SERVICE_ROLE_KEY=CHANGE_ME_JWT_SERVICE_ROLE
SECRET_KEY_BASE=CHANGE_ME_AT_LEAST_64_CHARS
REALTIME_DB_ENC_KEY=CHANGE_ME_16CHARS
DASHBOARD_USERNAME=kankyouken
DASHBOARD_PASSWORD=CHANGE_ME

# Opaque/asymmetric keys — leave blank, the pilot uses the legacy HS256 keys above.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_JWKS=

# --- TLS / proxy ---
# Public hostname of the VM. Caddy serves this; ports 80 and 443 are reachable
# from the open internet.
SITE_ADDRESS=gr-stiftl.ndx.cit.tum.de

# VESTIGIAL as of 2026-09-06. caddy/Caddyfile names the TUM/RBG certificate files
# directly, because they have to be referenced at their own absolute path - the
# symlinks under /var/lib/rbg-cert/live are absolute. This variable only matters if
# you delete that tls line and fall back to Caddy auto-provisioning Let's Encrypt.
CADDY_TLS=auto

# --- Public URLs (must be the https hostname above) ---
SUPABASE_PUBLIC_URL=https://gr-stiftl.ndx.cit.tum.de
API_EXTERNAL_URL=https://gr-stiftl.ndx.cit.tum.de/auth/v1
SITE_URL=https://gr-stiftl.ndx.cit.tum.de
ADDITIONAL_REDIRECT_URLS=

# --- Postgres ---
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Auth (pilot: token-based enrolment, mail sent manually) ---
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=noreply@localhost
SMTP_HOST=localhost
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=KanKyouKen
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# --- PostgREST ---
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# --- Edge functions ---
FUNCTIONS_VERIFY_JWT=false

# --- KN-202 application settings ---
# Required by functions/v1/auth-register, which EnrolmentApp calls to create a
# participant account. Without it the function demands a JWT the participant does
# not have and self-registration fails with 401.
# Trade-off: this opens account creation on a public host. Acceptable for a 15-person
# pilot; revisit (invite code or rate limit) before anything larger.
ALLOW_PUBLIC_REGISTRATION=true
