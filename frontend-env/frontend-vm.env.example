# Template for running the KanKyouKen frontend against the VM.
#
# The FILLED version of this file does NOT live in any repository. It lives at
#   %USERPROFILE%\.kankyouken\frontend-vm.env
# which is outside every checkout, so it cannot be committed by accident.
#
# Do not put these values in GitHub, private repo or not. SERVICE_ROLE_KEY bypasses
# row-level security completely; once it is in a repo it is in every clone forever.
#
# Fill it with:  scripts\frontend-vm.ps1 -Fetch      (pulls from the VM, prints nothing)
# Then run with: scripts\frontend-vm.ps1

NEXT_PUBLIC_SUPABASE_URL=https://gr-stiftl.ndx.cit.tum.de
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY from ~/deploy/.env on the VM>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from ~/deploy/.env on the VM>