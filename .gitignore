.env
*.pem
*.key
*.crt
*.dump
*.sql.gz
volumes/

# Built client bundles are artefacts, not source. They are produced by
#   EnrolmentApp:  VITE_BASE_PATH=/signup/ npm run build
#   FlashCardApp:  VITE_BASE_PATH=/study/  npm run build
# and synced onto the VM by scripts/deploy.sh. Only hand-written pages
# (the landing page, kanji-commons) are version-controlled under www/.
www/signup/
www/study/
# Written by scripts/push.sh on every push and rsync'd to the VM as provenance.
# It is an artefact of deploying, not a source file - and leaving it untracked made
# push.sh report its own repo DIRTY, caused by the file it had just written.
DEPLOYED.txt

# The frontend's VM env lives at %USERPROFILE%\.kankyouken\, never in a repo.
# This guards against someone copying it in here anyway.
frontend-env/frontend-vm.env
